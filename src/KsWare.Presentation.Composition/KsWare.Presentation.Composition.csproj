<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFrameworks>net462;net48;net6.0-windows;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Copyright>Copyright © 2002-2024 by KsWare. All rights reserved.</Copyright>
    <PackageLicenseFile></PackageLicenseFile>
    <PackageIconUrl></PackageIconUrl>
    <PackageProjectUrl>https://github.com/KsWare/KsWare.Presentation.Composition</PackageProjectUrl>
    <Description>
      Use CompositionBuilder and nothing else. ;-)
      Supports .Net 6.0+ and .Net 4.6.2+
    </Description>
    <Company>KsWare</Company>
    <Authors>SchreinerK</Authors>
    <Version>0.0.0</Version>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <PackageReleaseNotes>https://raw.githubusercontent.com/KsWare/KsWare.Presentation.Composition/develop/ChangeLog.md</PackageReleaseNotes>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Properties\KsWare.Presentation.Public.snk</AssemblyOriginatorKeyFile>
    <Product>KsWare Presentation</Product>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/KsWare/KsWare.Presentation.Composition</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mef CompositionBuilder compositiion</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(TargetName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(TargetName).xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Link="Properties\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommonServiceLocator" Version="2.0.7" />
    <PackageReference Include="KsWare.Presentation.Interfaces" Version="0.4.1" />
    <PackageReference Include="System.ComponentModel.Composition" Version="8.0.0" />
  </ItemGroup>

</Project>
